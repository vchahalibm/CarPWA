{
  "name": "studiogen",
  "productName": "StudioGen",
  "version": "0.14.0",
  "description": "StudioGen: the DriveGen web app on the desktop, for presenting on Stage",
  "repository": "github:vchahalibm/CarPWA",
  "main": "main.js",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "speech": "sh speech/build.sh",
    "ai": "sh ai/build.sh",
    "dist": "sh speech/build.sh && sh ai/build.sh && electron-builder --mac dmg zip --arm64 --x64",
    "dist:dir": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "io.github.vchahalibm.studiogen",
    "productName": "StudioGen",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "webview-preload.js",
      "updater.js",
      "tasks.js",
      "data.js",
      "speech.js",
      "ai.js",
      "link.js",
      "browse.js",
      "llm.js",
      "trayTemplate.png",
      "trayTemplate@2x.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "speech/bin/sg-speech",
        "to": "sg-speech"
      },
      {
        "from": "ai/bin/sg-ai",
        "to": "sg-ai"
      },
      {
        "from": "..",
        "to": "web",
        "filter": [
          "index.html",
          "manifest.webmanifest",
          "sw.js",
          "css/**",
          "js/**",
          "vendor/**",
          "icons/**",
          "presenter.html",
          "samples/**",
          "bridge/**",
          "labs/**",
          "docs/llm/**",
          "web-version.json",
          "!vendor/models/*.vrm",
          "!vendor/mediapipe/models/*.task",
          "!vendor/mediapipe/wasm/*.wasm"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.navigation",
      "icon": "../icons/studiogen-1024.png",
      "identity": null,
      "hardenedRuntime": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "StudioGen listens for your voice commands.",
        "NSSpeechRecognitionUsageDescription": "StudioGen turns what you say into commands and conversation.",
        "NSCameraUsageDescription": "StudioGen uses the camera to follow the presenter and recognise objects.",
        "NSAppleEventsUsageDescription": "StudioGen runs the tasks in your scripts that control other apps.",
        "NSLocationUsageDescription": "StudioGen shows where you are and guides you.",
        "NSLocationWhenInUseUsageDescription": "StudioGen shows where you are and guides you."
      },
      "target": [
        "dmg",
        "zip"
      ]
    },
    "dmg": {
      "title": "StudioGen ${version}"
    },
    "linux": {
      "target": "AppImage",
      "icon": "../icons/studiogen-1024.png"
    },
    "win": {
      "target": "nsis",
      "icon": "../icons/studiogen-1024.png"
    },
    "publish": null,
    "electronLanguages": [
      "en"
    ],
    "asarUnpack": [
      "node_modules/node-llama-cpp/**",
      "node_modules/@node-llama-cpp/**"
    ],
    "afterPack": "build/sign.js"
  },
  "dependencies": {
    "node-llama-cpp": "^3.22.2"
  }
}
