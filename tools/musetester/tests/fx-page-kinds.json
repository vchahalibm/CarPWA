{
  "id": "fx-page-kinds", "title": "Every kind of page watcher on fixture pages: new, gone, changes, words, a number, a count, a pattern", "tags": ["watchers", "kinds", "fixtures"],
  "steps": [
    { "do": "launch", "practice": false },
    { "do": "fixture", "name": "list", "items": ["Alpha report", "Beta report"], "why": "A page with a list" },
    { "do": "watch.make", "name": "fx new", "set": { "url": "${fx.list}", "rows": "#list .row", "detect": { "kind": "new", "gone": true } } },
    { "do": "watch.check", "name": "fx new", "why": "First look" },
    { "do": "fixture", "name": "list", "items": ["Gamma report", "Alpha report"], "why": "One added, one gone" },
    { "do": "watch.check", "name": "fx new" },
    { "do": "expect", "var": "check.hit.headline", "contains": "1 new, 1 gone", "why": "One new, one gone" },
    { "do": "expect", "var": "check.hit.items", "contains": "Gamma", "why": "New: Gamma" },
    { "do": "expect", "var": "check.hit.items", "contains": "Gone", "why": "…and Beta gone" },
    { "do": "fixture", "name": "policy", "html": "<main id='p'>Returns within 30 days. Updated 1 Nov 2026 10:00.</main>" },
    { "do": "watch.make", "name": "fx changes", "set": { "url": "${fx.policy}", "read": "#p", "detect": { "kind": "changes" } } },
    { "do": "watch.check", "name": "fx changes" },
    { "do": "fixture", "name": "policy", "html": "<main id='p'>Returns within 30 days. Updated 2 Nov 2026 11:30.</main>", "why": "Only the date moves" },
    { "do": "watch.check", "name": "fx changes" },
    { "do": "expect", "var": "check.hit", "equals": null, "why": "A date moving isn't a change" },
    { "do": "fixture", "name": "policy", "html": "<main id='p'>Returns within 14 days. Updated 2 Nov 2026 11:30.</main>" },
    { "do": "watch.check", "name": "fx changes" },
    { "do": "expect", "var": "check.hit.items", "contains": "14 days", "why": "The real change is told" },
    { "do": "fixture", "name": "price", "html": "<span id='price'>₹12,499</span>" },
    { "do": "watch.make", "name": "fx value", "set": { "url": "${fx.price}", "read": "#price", "detect": { "kind": "value", "cond": "below 12000" } } },
    { "do": "watch.check", "name": "fx value" },
    { "do": "fixture", "name": "price", "html": "<span id='price'>₹11,799</span>" },
    { "do": "watch.check", "name": "fx value" },
    { "do": "expect", "var": "check.hit.headline", "match": "11,?799|below", "why": "Below 12000 told" },
    { "do": "watch.make", "name": "fx drop", "set": { "url": "${fx.price}", "read": "#price", "detect": { "kind": "value", "cond": "drops 5%" } } },
    { "do": "watch.check", "name": "fx drop" },
    { "do": "fixture", "name": "price", "html": "<span id='price'>₹10,999</span>" },
    { "do": "watch.check", "name": "fx drop" },
    { "do": "expect", "var": "check.hit", "why": "A 6.8% drop told" },
    { "do": "fixture", "name": "slots", "html": "<p>No appointment slots available.</p>" },
    { "do": "watch.make", "name": "fx words", "set": { "url": "${fx.slots}", "read": "body", "detect": { "kind": "contains", "words": "slots open||book now" } } },
    { "do": "watch.check", "name": "fx words" },
    { "do": "fixture", "name": "slots", "html": "<p>Slots open for 12 Nov. Book now.</p>" },
    { "do": "watch.check", "name": "fx words" },
    { "do": "expect", "var": "check.hit", "why": "The words appeared" },
    { "do": "fixture", "name": "tickets", "items": ["Open 1", "Open 2"] },
    { "do": "watch.make", "name": "fx count", "set": { "url": "${fx.tickets}", "rows": "#list .row", "detect": { "kind": "count", "cond": "above 3" } } },
    { "do": "watch.check", "name": "fx count" },
    { "do": "fixture", "name": "tickets", "items": ["Open 1", "Open 2", "Open 3", "Open 4"] },
    { "do": "watch.check", "name": "fx count" },
    { "do": "expect", "var": "check.hit", "why": "Above 3 told" },
    { "do": "fixture", "name": "status", "html": "<div id='s'>All systems operational</div>" },
    { "do": "watch.make", "name": "fx pattern", "set": { "url": "${fx.status}", "read": "#s", "detect": { "kind": "pattern", "re": "incident|degraded|outage" } } },
    { "do": "watch.check", "name": "fx pattern" },
    { "do": "fixture", "name": "status", "html": "<div id='s'>Degraded performance: API</div>" },
    { "do": "watch.check", "name": "fx pattern" },
    { "do": "expect", "var": "check.hit", "why": "The pattern matched" },
    { "do": "errors.none", "ignore": ["ResizeObserver"] }
  ]
}
